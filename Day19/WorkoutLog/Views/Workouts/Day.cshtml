@model IEnumerable<WorkoutLog.Models.Workout>

@{
    ViewData["Title"] = "Тренировки за день";
    var selectedDate = ViewBag.SelectedDate as DateTime?;
}

<h1>Тренировки за @selectedDate?.ToString("dd.MM.yyyy")</h1>

<p>
    <a asp-action="Index" class="btn btn-secondary">Вернуться к списку</a>
    <a asp-action="Create" class="btn btn-success">Добавить тренировку</a>
</p>

@if (Model.Any())
{
    <div class="alert alert-info">
        <strong>Всего тренировок:</strong> @Model.Count() <br />
        <strong>Общая продолжительность:</strong> @Model.Sum(w => w.Duration) минут
    </div>

    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Тип тренировки</th>
                <th>Продолжительность</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Type</td>
                    <td>@item.Duration мин</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Изменить</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">
        На выбранную дату тренировок не найдено.
    </div>
}