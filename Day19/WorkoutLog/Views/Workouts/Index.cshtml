@model IEnumerable<WorkoutLog.Models.Workout>

@{
    ViewData["Title"] = "Тренировочный журнал";
}

<h1>Тренировочный журнал</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Добавить тренировку</a>
</p>

<div class="mb-3">
    <label>Фильтр по дате:</label>
    <input type="date" id="dateFilter" class="form-control" style="max-width: 200px;" />
    <button onclick="filterByDate()" class="btn btn-primary mt-2">Показать тренировки за день</button>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Date)</th>
            <th>@Html.DisplayNameFor(model => model.Type)</th>
            <th>@Html.DisplayNameFor(model => model.Duration)</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Date.ToString("dd.MM.yyyy")</td>
                <td>@item.Type</td>
                <td>@item.Duration мин</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Изменить</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="alert alert-info">Тренировки не найдены. Добавьте первую тренировку!</p>
}

@section Scripts {
    <script>
        function filterByDate() {
            var date = document.getElementById('dateFilter').value;
            if (date) {
                window.location.href = '/Workouts/Day/' + date;
            } else {
                alert('Выберите дату');
            }
        }
    </script>
}