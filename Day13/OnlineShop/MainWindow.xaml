<Window x:Class="OnlineShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OnlineShop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddOrderCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditOrderCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DeleteOrderCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="Заказы">
                <MenuItem Header="Добавить" Command="{Binding AddOrderCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Редактировать" Command="{Binding EditOrderCommand}" InputGestureText="Ctrl+E"/>
                <MenuItem Header="Удалить" Command="{Binding DeleteOrderCommand}" InputGestureText="Ctrl+D"/>
            </MenuItem>
        </Menu>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10">
            <Button Content="Новый" Command="{Binding AddOrderCommand}" Width="120" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0"/>
            <Button Content="Правка" Command="{Binding EditOrderCommand}" Width="120" Height="35" Margin="0,0,10,0" Background="#2196F3" Foreground="White" BorderThickness="0"/>
            <Button Content="Удалить" Command="{Binding DeleteOrderCommand}" Width="120" Height="35" Background="#F44336" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="10,0,10,10">
            <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="StatusFilter" Width="150" SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="Все" IsSelected="True"/>
                <ComboBoxItem Content="Новый"/>
                <ComboBoxItem Content="Оплачен"/>
                <ComboBoxItem Content="Доставлен"/>
            </ComboBox>
        </StackPanel>

        <DataGrid x:Name="OrdersGrid" Grid.Row="3" Margin="10"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Client}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} руб.}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
