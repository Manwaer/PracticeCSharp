<Window x:Class="OnlineShop.CreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление заказом"
        Height="380"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9F9F9">
    <StackPanel Margin="20">
        <TextBlock Text="Клиент:"/>
        <TextBox x:Name="TxtClient" Margin="0,5,0,10"/>

        <TextBlock Text="Сумма:"/>
        <TextBox x:Name="TxtAmount" Margin="0,5,0,10"/>

        <TextBlock Text="Статус:"/>
        <ComboBox x:Name="CbStatus" Margin="0,5,0,10">
            <ComboBoxItem Content="Новый"/>
            <ComboBoxItem Content="Оплачен"/>
            <ComboBoxItem Content="Доставлен"/>
        </ComboBox>

        <TextBlock Text="Детали:"/>
        <TextBox x:Name="TxtDetails"
                 Margin="0,5,0,20"
                 Height="80"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"/>

        <UniformGrid Columns="2">
            <Button Content="Сохранить"
                    Click="OnSaveClick"
                    Background="#4CAF50"
                    Foreground="White"/>
            <Button Content="Отмена"
                    Click="OnCancelClick"
                    Margin="10,0,0,0"/>
        </UniformGrid>
    </StackPanel>
</Window>