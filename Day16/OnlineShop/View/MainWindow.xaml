<Window x:Class="OnlineShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OnlineShop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddOrderCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditOrderCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DeleteOrderCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="Файл">
                    <MenuItem Header="Выход"/>
                </MenuItem>
                <MenuItem Header="Заказы">
                    <MenuItem Header="Добавить" Command="{Binding AddOrderCommand}" InputGestureText="Ctrl+N"/>
                    <MenuItem Header="Редактировать" Command="{Binding EditOrderCommand}" InputGestureText="Ctrl+E"/>
                    <MenuItem Header="Удалить" Command="{Binding DeleteOrderCommand}" InputGestureText="Ctrl+D"/>
                </MenuItem>
            </Menu>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
                <Button Content="Новый заказ" Command="{Binding AddOrderCommand}" Width="120" Height="30" Margin="0,0,5,0" Background="#4CAF50" Foreground="White" BorderThickness="0"/>
                <Button Content="Правка" Command="{Binding EditOrderCommand}" Width="100" Height="30" Margin="0,0,5,0" Background="#2196F3" Foreground="White" BorderThickness="0"/>
                <Button Content="Удалить" Command="{Binding DeleteOrderCommand}" Width="100" Height="30" Background="#F44336" Foreground="White" BorderThickness="0"/>

                <Separator Margin="15,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                <TextBlock Text="Фильтр:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox SelectedValuePath="Content" SelectedValue="{Binding SelectedStatusFilter}" Width="150" VerticalAlignment="Center">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Новый"/>
                    <ComboBoxItem Content="Оплачен"/>
                    <ComboBoxItem Content="Доставлен"/>
                </ComboBox>
            </StackPanel>

            <Grid DockPanel.Dock="Right" Width="220" Margin="0,10,10,10">
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="#F9F9F9">
                    <DockPanel Margin="10">
                        <TextBlock Text="Чат поддержки" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <Button DockPanel.Dock="Bottom" Content="Чат" Height="25" Margin="0,5,0,0" Background="#607D8B" Foreground="White" BorderThickness="0"/>
                        <TextBox Text="{Binding ChatLog}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="#CCC"/>
                    </DockPanel>
                </Border>
            </Grid>

            <DataGrid x:Name="OrdersGrid" 
                      ItemsSource="{Binding OrdersView}" 
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Margin="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding Client}" Width="*"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2} руб.}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Grid Background="#90000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40">
                <StackPanel>
                    <TextBlock Text="Обработка данных..." FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
                    <TextBlock Text="Сохранение в JSON и уведомление MMF" Foreground="Gray" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>